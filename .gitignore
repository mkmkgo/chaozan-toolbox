# 依赖与构建产物
node_modules/
dist/
vendor/*/node_modules/
vendor/*/dist/
vendor/*/out/
vendor/*/.next/

# 例外：这两个第三方工具是预构建产物（纯静态，不含 node_modules），
# 为了 EdgeOne Pages 的 Git 自动部署能零依赖直接 `node scripts/build.mjs`，
# 把它们随源码一起入库。升级上游后需重新构建并提交。
!vendor/Mini-Cover-main/dist/
!vendor/cover-main/out/

# 第三方源码压缩包（由 scripts/fetch-vendor.mjs 拉取）
vendor/*.zip

# 说明：vendor/ 下的**源码**是入库的。
# 原因：本站对上游做了品牌替换与静态导出改造，不入库的话 clone 下来构建出来的是原版。
# 上游项目均为 MIT，允许再分发，版权声明见 NOTICE 与 THIRD-PARTY-LICENSES/。
# 以下为上游仓库里与本站无关的产物/元数据
vendor/*/package-lock.json
vendor/*/pnpm-lock.yaml
vendor/*/pnpm-workspace.yaml
vendor/cover-main/.agent/
vendor/cover-main/worker.js

# 环境变量（含 API Key，不要入库）
.env.local
.env
# 但第三方项目里的配置模板要入库（已确认不含任何真实密钥）
!vendor/Mini-Cover-main/.env
!vendor/cover-main/.env.local

# EdgeOne CLI 产物
.edgeone/

# 系统与编辑器
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/

# 本地临时文件（测试脚本、截图）
.tmp/

# AI 工作日志（本地留存，不发布到公开仓库）
.workbuddy-ai/
