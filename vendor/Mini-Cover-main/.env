# 网站标题
VITE_APP_TITLE = Mini-Cover

# 备案号：留空则不展示（请勿沿用原作者备案号）
VITE_APP_ICP_NUMBER =

# 图床上传接口：留空则关闭上传到第三方图床，图片只在本地处理
VITE_APP_UPLOAD_API_URL =

# 设置全局字体（可选）不填写则默认
# 用系统自带字体，避免依赖任何第三方字体 CDN
VITE_APP_FONT_FAMILY = Microsoft YaHei

# 引入网络字体链接（可选）不填写则不引入
# 原值指向原作者自建 CDN（oss-cdn.bsgun.cn），为避免占用他人带宽已清空。
# 想用霞鹜文楷可自行下载 woff2 放到 public/fonts/ 再填本地路径。
VITE_APP_FONT_CSS_URL =
